# ============================================================================
# VARIÁVEIS DE AMBIENTE - Template para Configuração
# ============================================================================
# COPIE este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env! Apenas este template vai para o repositório.
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# ----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://windlog:windlog_dev@localhost:5432/windlog_dev"

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# JWT (Autenticação)
# ----------------------------------------------------------------------------
# IMPORTANTE: Em produção, use uma string longa e aleatória!
# Exemplo: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# UPLOAD DE FICHEIROS
# ----------------------------------------------------------------------------
# Diretório base para armazenamento de ficheiros (relativo à raiz do projeto)
UPLOAD_DIR=./uploads

# Tamanho máximo de um ficheiro em bytes (default: 10MB = 10485760)
MAX_FILE_SIZE=10485760

# Tempo de vida dos tokens temporários em segundos (default: 5 min = 300s)
FILE_TOKEN_TTL=300
