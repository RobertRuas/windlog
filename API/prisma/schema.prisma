// ============================================================================
// PRISMA SCHEMA - Definição do Banco de Dados
// ============================================================================
//
// O QUE É ESTE ARQUIVO?
// ---------------------
// Este é o arquivo central do Prisma ORM. Ele define TODA a estrutura do
// banco de dados: tabelas (models), relacionamentos, enums e configurações.
//
// POR QUE PRISMA?
// ---------------
// Prisma oferece type-safety (segurança de tipos) gerando automaticamente
// tipos TypeScript baseados no schema. Isso significa que o banco de dados
// e o código estão sempre sincronizados.
//
// COMO FUNCIONA?
// --------------
// 1. Defina os models aqui
// 2. Rode: npx prisma migrate dev --name nome_da_migration
// 3. O Prisma cria as tabelas no PostgreSQL automaticamente
// 4. O código TypeScript ganha acesso aos tipos gerados
//
// CONVENÇÕES IMPORTANTES:
// -----------------------
// - IDs sempre em UUID (universally unique identifiers)
// - Datas sempre em UTC (horário universal)
// - Soft Delete: nunca apagamos dados, usamos o campo 'deletedAt'
// - Todo registro pertence a uma empresa (multi-tenant)
// - Nomes de models em PascalCase (ex: User, Project)
// - Nomes de campos em camelCase (ex: createdAt, firstName)
//
// NOTA PRISMA v7:
// ---------------
// A URL do banco NÃO fica mais aqui. Ela está em 'prisma.config.ts'.
// O client é gerado em './generated/prisma' (não mais em node_modules).
// ============================================================================

// ---------------------------------------------------------------------------
// CONFIGURAÇÃO DO GENERADOR
// ---------------------------------------------------------------------------
// 'prisma-client' é o novo provider (substitui 'prisma-client-js')
// 'output' define onde o client TypeScript será gerado
// IMPORTANTE: Após 'prisma generate', importe de './generated/prisma/client'
// ---------------------------------------------------------------------------
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// ---------------------------------------------------------------------------
// DATASOURCE - Configuração do Banco de Dados
// ---------------------------------------------------------------------------
// Define qual banco de dados usar (PostgreSQL)
// A URL da conexão está em 'prisma.config.ts' (novo no Prisma v7)
// ---------------------------------------------------------------------------
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUM: ROLE (Papéis de Usuário)
// ---------------------------------------------------------------------------
// Define os níveis de acesso do sistema (RBAC - Role-Based Access Control)
// Cada role tem permissões diferentes:
//
// - ADMIN:      Acesso completo ao sistema (gestão total)
// - HR:         Recursos Humanos (gestão de funcionários, certificados)
// - STANDARD:   Acesso padrão (operações básicas do dia-a-dia)
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  HR
  STANDARD
}

// ---------------------------------------------------------------------------
// ENUM: LANGUAGE LEVEL (Nível de Proficiência em Idiomas)
// ---------------------------------------------------------------------------
// Escala CEFR (Common European Framework of Reference for Languages)
// Usada para padronizar o nível de todos os idiomas dos funcionários
// ---------------------------------------------------------------------------
enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

// ---------------------------------------------------------------------------
// ENUM: DOCUMENT TYPE (Tipo de Documento Pessoal)
// ---------------------------------------------------------------------------
// Classifica os documentos pessoais dos funcionários multinacionais.
// Cada trabalhador internacional precisa de diversos documentos válidos
// para trabalhar legalmente em diferentes países.
// ---------------------------------------------------------------------------
enum DocumentType {
  PASSPORT
  ID_CARD
  TAX_ID
  SOCIAL_SECURITY
  WORK_PERMIT
  VISA
  DRIVERS_LICENSE
  POSTING_ORDER      // Destacamento (A1)
  MEDICAL_EXAM       // Exame médico
  OTHER
}

// ---------------------------------------------------------------------------
// ENUM: CERTIFICATION TYPE (Tipo de Certificação)
// ---------------------------------------------------------------------------
// Classifica o tipo de certificação/cursos dos funcionários
// ---------------------------------------------------------------------------
enum CertificationType {
  CERTIFICATION
  DIPLOMA
  COURSE
  TRAINING
  LICENSE
}

// ---------------------------------------------------------------------------
// MODEL: USER (Usuário do Sistema)
// ---------------------------------------------------------------------------
// Representa qualquer funcionário da empresa multinacional.
//
// CAMPOS OBRIGATÓRIOS (apenas no cadastro inicial):
// - email, password, firstName, lastName, role
//
// CAMPOS OPCIONAIS (preenchidos posteriormente):
// - Dados pessoais: phone, dateOfBirth, nationality, address
// - Dados profissionais: department, position, hireDate, bio
//
// RELACIONAMENTOS:
// - Um usuário pode ter múltiplos números de telefone
// - Um usuário pode ter múltiplas certificações/cursos
// - Um usuário pode falar múltiplos idiomas (cada um com seu nível)
// ---------------------------------------------------------------------------
model User {
  // Identificador único (UUID v4 gerado automaticamente pelo banco)
  id        String   @id @default(uuid())

  // Dados de autenticação
  email     String   @unique
  password  String

  // Dados pessoais (obrigatórios)
  firstName String
  lastName  String

  // Dados pessoais (opcionais - preenchidos posteriormente)
  /// Número de telefone principal (formato internacional)
  phone           String?
  /// Código do país do telefone (ex: "+351", "+33", "+49")
  phoneCountryCode String?
  /// Data de nascimento
  dateOfBirth     DateTime?
  /// Nacionalidade (código ISO 3166-1 alpha-2, ex: "PT", "FR", "DE")
  nationality     String?
  /// Endereço completo
  address         String?
  /// Cidade
  city            String?
  /// Código postal
  postalCode      String?
  /// País de residência (código ISO 3166-1 alpha-2)
  country         String?

  // Dados profissionais
  /// Departamento (ex: "Operations", "Maintenance", "Engineering")
  department      String?
  /// Cargo/função (ex: "Wind Turbine Technician", "Site Supervisor")
  position        String?
  /// Data de contratação na empresa
  hireDate        DateTime?
  /// Número de funcionário (ID interno da empresa)
  employeeId      String?   @unique
  /// Biografia/resumo profissional
  bio             String?

  // Documentos pessoais
  // Os documentos são geridos como relação (UserDocument) para suportar
  // múltiplos documentos de cada tipo com uploads de cópias.
  /// URL da foto do usuário (ficheiro alojado)
  photoUrl            String?

  // Controle de acesso (RBAC)
  role      Role     @default(STANDARD)
  isActive  Boolean  @default(true)
  /// Indica se o usuário precisa trocar a senha no próximo login (ex: senha temporária)
  mustChangePassword Boolean @default(false)

  // Timestamps (datas em UTC)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  // Relações
  phoneNumbers    UserPhoneNumber[]
  certifications  UserCertification[]
  languages       UserLanguage[]
  documents       UserDocument[]
  bankAccounts    UserBankAccount[]
  projectMembers  ProjectMember[]
  projectFiles    ProjectFile[]
}
// ---------------------------------------------------------------------------
// MODEL: USER DOCUMENT (Documentos Pessoais do Usuário)
// ---------------------------------------------------------------------------
// Registra todos os documentos pessoais do usuário.
// Contexto multinacional: funcionários trabalham em vários países e
// precisam manter documentos válidos com cópias digitalizadas.
//
// EXEMPLOS:
// - Passaporte português com validade até 2030
// - Cartão de identidade espanhol
// - NIF (Número de Identificação Fiscal) de Portugal
// - Visto de trabalho para a Alemanha
// - Permissão de residência na França
// ---------------------------------------------------------------------------
model UserDocument {
  id        String   @id @default(uuid())

  // Dados do documento
  /// Tipo de documento (enum DocumentType)
  type        DocumentType
  /// Número do documento (ex: "AB123456", "123456789")
  documentNumber String?
  /// País emissor (código ISO 3166-1 alpha-2, ex: "PT", "FR", "DE")
  issuingCountry String?
  /// Data de expedição do documento
  issueDate   DateTime?
  /// Data de validade/expiração do documento
  expiryDate  DateTime?
  /// Descrição ou notas adicionais (ex: "Visto tipo D", "Permissão de residência")
  description String?

  // Ficheiro anexado ao documento (caminho relativo ao diretório uploads/)
  /// Caminho do ficheiro anexado ao documento (relativo a uploads/{userId}/documents/)
  filePath  String?

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// MODEL: USER BANK ACCOUNT (Contas Bancárias do Usuário)
// ---------------------------------------------------------------------------
// Regista as contas bancárias do usuário para processamento de pagamentos.
// Um usuário pode ter múltiplas contas bancárias.
// ---------------------------------------------------------------------------
model UserBankAccount {
  id              String   @id @default(uuid())

  /// Nome do banco (ex: "Millennium BCP", "Caixa Geral de Depósitos")
  bankName        String
  /// IBAN (International Bank Account Number)
  iban            String
  /// Código BIC/SWIFT
  bicSwift        String?
  /// Nome completo do titular da conta
  accountHolder   String
  /// Se é a conta principal do usuário
  isPrimary       Boolean  @default(false)
  /// Descrição opcional (ex: "Conta salário", "Conta pessoal")
  description     String?

  // Relação com o usuário
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: USER PHONE NUMBER (Números de Telefone do Usuário)
// ---------------------------------------------------------------------------
// Permite que o usuário tenha múltiplos números de telefone
// de diferentes países (contexto multinacional).
//
// EXEMPLO:
// - Telefone pessoal de Portugal (+351)
// - Telefone de trabalho da França (+33)
// ---------------------------------------------------------------------------
model UserPhoneNumber {
  id        String   @id @default(uuid())

  /// Código do país (ex: "+351", "+33", "+49", "+34")
  countryCode String
  /// Número de telefone (sem código do país)
  number      String
  /// Tipo do número (móvel, fixo, trabalho, etc.)
  type        String   @default("mobile")
  /// Se é o número principal do usuário
  isPrimary   Boolean  @default(false)

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: USER CERTIFICATION (Certificações, Diplomas e Cursos)
// ---------------------------------------------------------------------------
// Registra todas as certificações profissionais do usuário.
// Usado para:
// - Certificações de manutenção de turbinas eólicas
// - Diplomas de formação técnica
// - Cursos de segurança (GWO, etc.)
// - Licenças profissionais
//
// CAMPOS IMPORTANTES:
// - issueDate:   Data em que a certificação foi obtida
// - expiryDate:  Data de validade (usado para alertas de renovação)
// - isExpired:   Calculado automaticamente com base na expiryDate
// ---------------------------------------------------------------------------
model UserCertification {
  id        String   @id @default(uuid())

  // Dados da certificação
  /// Nome/título da certificação (ex: "GWO BST", "IEC 61400", "Electrical Safety")
  name        String
  /// Entidade emissora (ex: "GWO", "Vestas", "Siemens Gamesa", "Ministry of Education")
  issuer      String
  /// Tipo de certificação (enum CertificationType)
  type        CertificationType
  /// Descrição detalhada (opcional)
  description String?
  /// Número/ID da certificação (ex: "GWO-2024-12345")
  certNumber  String?

  // Datas importantes
  /// Data de expedição (quando obteve a certificação)
  issueDate   DateTime
  /// Data de expiração (null = não expira)
  expiryDate  DateTime?

  // Arquivo/comprovativo (caminho para upload futuro)
  filePath    String?

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// MODEL: USER LANGUAGE (Idiomas Falados pelo Usuário)
// ---------------------------------------------------------------------------
// Registra cada idioma que o usuário fala com seu respectivo nível.
// Contexto multinacional: funcionários trabalham em vários países
// da União Europeia e precisam comunicar-se em diferentes idiomas.
//
// EXEMPLO:
// - Português (NATIVE)
// - Inglês (C1)
// - Francês (B2)
// - Espanhol (A2)
// ---------------------------------------------------------------------------
model UserLanguage {
  id        String   @id @default(uuid())

  /// Nome do idioma (ex: "English", "French", "German", "Spanish")
  language  String
  /// Nível de proficiência (escala CEFR: A1, A2, B1, B2, C1, C2, NATIVE)
  level     LanguageLevel

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, language])
}

// ---------------------------------------------------------------------------
// ENUM: PROJECT STATUS (Status do Projeto)
// ---------------------------------------------------------------------------
// Define os possíveis status de um projeto no sistema
// ---------------------------------------------------------------------------
enum ProjectStatus {
  PLANNING      // Planeamento
  IN_PROGRESS   // Em progresso
  ON_HOLD       // Em espera
  COMPLETED     // Concluído
  CANCELLED     // Cancelado
}

// ---------------------------------------------------------------------------
// ENUM: TURBINE STATUS (Status da Turbina)
// ---------------------------------------------------------------------------
// Define os possíveis status de uma turbina
// ---------------------------------------------------------------------------
enum TurbineStatus {
  OPERATIONAL   // Operacional
  MAINTENANCE   // Em manutenção
  OFFLINE       // Offline
  DECOMMISSIONED // Descomissionada
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT (Projeto)
// ---------------------------------------------------------------------------
// Representa um projeto de manutenção/instalação de turbinas eólicas.
// Um projeto agrupa turbinas e técnicos para um trabalho específico.
//
// CAMPOS OBRIGATÓRIOS (criação mínima):
// - name, client, location
//
// CAMPOS OPCIONAIS (preenchidos posteriormente):
// - scope, description, coordinates, startDate, status
// ---------------------------------------------------------------------------
model Project {
  id        String   @id @default(uuid())

  // Informações básicas (obrigatórias)
  /// Nome do projeto (ex: "Parque Eólico Serra do Mar")
  name        String
  /// Cliente/proprietário do projeto (ex: "EDP Renewables")
  client      String
  /// Localização geral do projeto (ex: "Serra do Mar, Portugal")
  location    String

  // Informações complementares (opcionais)
  /// Escopo do projeto (ex: "Manutenção preventiva", "Instalação")
  scope       String?
  /// Descrição detalhada do projeto
  description String?
  /// Latitude do centro do projeto (coordenadas geográficas)
  latitude    Float?
  /// Longitude do centro do projeto (coordenadas geográficas)
  longitude   Float?
  /// Data de início do projeto
  startDate   DateTime?
  /// Status atual do projeto (enum ProjectStatus)
  status      ProjectStatus @default(PLANNING)

  // Controle de acesso
  isActive    Boolean  @default(true)

  // Timestamps (datas em UTC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relações
  turbines    ProjectTurbine[]
  members     ProjectMember[]
  files       ProjectFile[]
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT TURBINE (Turbina do Projeto)
// ---------------------------------------------------------------------------
// Representa uma turbina associada a um projeto.
// Cada turbina tem informações básicas de localização e modelo.
// ---------------------------------------------------------------------------
model ProjectTurbine {
  id        String   @id @default(uuid())

  // Dados da turbina
  /// Nome/identificação da turbina (ex: "T-001", "Vestas V100 #3")
  name        String
  /// Localização específica da turbina
  location    String?
  /// Fabricante (ex: "Vestas", "Siemens Gamesa", "GE Renewable Energy")
  manufacturer String?
  /// Modelo da turbina (ex: "V100-1.8 MW", "SG 4.5-145")
  model       String?
  /// Altura do nacelle (em metros)
  nacelleHeight Float?
  /// Latitude da turbina (coordenadas geográficas)
  latitude    Float?
  /// Longitude da turbina (coordenadas geográficas)
  longitude   Float?
  /// Status atual da turbina (enum TurbineStatus)
  status      TurbineStatus @default(OPERATIONAL)

  // Relação com o projeto
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT MEMBER (Membro do Projeto)
// ---------------------------------------------------------------------------
// Associa usuários (técnicos) a projetos.
// Permite saber quais técnicos estão atribuídos a cada projeto.
// ---------------------------------------------------------------------------
model ProjectMember {
  id        String   @id @default(uuid())

  // Relação com o projeto
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Função do membro no projeto (ex: "Lead Technician", "Technician")
  role      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT FILE (Ficheiros do Projeto)
// ---------------------------------------------------------------------------
// Registra os ficheiros anexados a um projeto (relatórios, fotos, etc.).
// O caminho real do ficheiro está em uploads/{userId}/projects/{filename}.
// ---------------------------------------------------------------------------
model ProjectFile {
  id        String   @id @default(uuid())

  /// Nome original do ficheiro (ex: "relatorio_janeiro.pdf")
  originalName String
  /// Caminho relativo ao diretório uploads/ (ex: "userId/projects/uuid.pdf")
  filePath     String
  /// Tipo MIME do ficheiro (ex: "application/pdf", "image/jpeg")
  mimeType     String
  /// Tamanho do ficheiro em bytes
  size         Int
  /// Categoria/descrição opcional (ex: "Relatório", "Foto", "Certificado")
  category     String?

  // Relações
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ID do usuário que fez o upload
  uploadedBy   String
  user         User    @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([projectId])
  @@index([uploadedBy])
}

// ---------------------------------------------------------------------------
// ENUM: LOG ACTION (Ações Registradas no Log)
// ---------------------------------------------------------------------------
// Define todas as ações que podem ser registradas no log do sistema.
// Usado para auditoria e rastreamento de atividades.
// ---------------------------------------------------------------------------
enum LogAction {
  // Autenticação
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  
  // Gestão de Usuários
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_DEACTIVATE
  USER_REACTIVATE
  USER_ROLE_CHANGE
  
  // Perfil
  PROFILE_UPDATE
  PROFILE_VIEW
  
  // Telefones
  PHONE_ADD
  PHONE_UPDATE
  PHONE_DELETE
  
  // Certificações
  CERTIFICATION_ADD
  CERTIFICATION_UPDATE
  CERTIFICATION_DELETE
  
  // Idiomas
  LANGUAGE_ADD
  LANGUAGE_UPDATE
  LANGUAGE_DELETE
  
  // Documentos
  DOCUMENT_ADD
  DOCUMENT_UPDATE
  DOCUMENT_DELETE
  
  // Projetos
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  
  // Turbinas
  TURBINE_CREATE
  TURBINE_UPDATE
  TURBINE_DELETE
  
  // Técnicos
  TECHNICIAN_CREATE
  TECHNICIAN_UPDATE
  TECHNICIAN_DELETE
  
  // Ficheiros de Projeto
  PROJECT_FILE_CREATE
  PROJECT_FILE_DELETE
  
  // Sistema
  SYSTEM_ERROR
  API_ERROR
  ACCESS_DENIED
  DATA_EXPORT
  DATA_IMPORT
  
  // Outros
  OTHER
}

// ---------------------------------------------------------------------------
// ENUM: LOG SEVERITY (Nível de Severidade do Log)
// ---------------------------------------------------------------------------
// Classifica a severidade/importância do log registrado.
// ---------------------------------------------------------------------------
enum LogSeverity {
  INFO      // Informação geral (ações normais)
  WARNING   // Aviso (algo incomum mas não crítico)
  ERROR     // Erro (algo falhou)
  CRITICAL  // Crítico (falha grave do sistema)
}

// ---------------------------------------------------------------------------
// MODEL: SYSTEM LOG (Log do Sistema)
// ---------------------------------------------------------------------------
// Registra TODAS as ações realizadas no sistema para auditoria e segurança.
// Cada log captura detalhes completos da ação realizada.
//
// CAMPOS IMPORTANTES:
// - action:      O que foi feito (enum LogAction)
// - severity:    Nível de importância (INFO, WARNING, ERROR, CRITICAL)
// - userId:      Quem fez a ação (null se foi ação do sistema)
// - entity:      Qual entidade foi afetada (User, Project, etc.)
// - entityId:    ID da entidade afetada
// - details:     Detalhes adicionais em JSON (dados antigos, novos, etc.)
// - ipAddress:   IP de onde a ação foi realizada
// - userAgent:   Browser/client usado
// - url:         URL/endpoint acessado
// - method:      Método HTTP (GET, POST, PUT, DELETE)
// - statusCode:  Código HTTP da resposta
// - duration:    Tempo de execução da ação em ms
// ---------------------------------------------------------------------------
model SystemLog {
  id        String   @id @default(uuid())

  // Ação realizada
  /// O que foi feito (enum LogAction)
  action    LogAction
  /// Nível de severidade/importância
  severity  LogSeverity @default(INFO)
  /// Descrição legível da ação (ex: "Usuário atualizou perfil")
  message   String

  // Quem fez a ação
  /// ID do usuário que realizou a ação (null se foi ação do sistema)
  userId    String?
  /// Nome do usuário (denormalizado para performance na consulta)
  userName  String?
  /// Email do usuário (denormalizado para performance na consulta)
  userEmail String?

  // O que foi afetado
  /// Tipo da entidade afetada (ex: "User", "Project", "Certification")
  entity    String?
  /// ID da entidade afetada
  entityId  String?
  /// Nome/título da entidade (denormalizado para exibição)
  entityName String?

  // Detalhes adicionais
  /// Dados adicionais em formato JSON (dados antigos, novos valores, etc.)
  details   Json?
  /// Metadata adicional (headers, query params, etc.)
  metadata  Json?

  // Contexto da requisição
  /// Endereço IP de onde a ação foi realizada
  ipAddress String?
  /// User-Agent do browser/client
  userAgent String?
  /// URL/endpoint acessado
  url       String?
  /// Método HTTP (GET, POST, PUT, DELETE, PATCH)
  method    String?
  /// Código HTTP da resposta (200, 201, 400, 401, 403, 404, 500, etc.)
  statusCode Int?
  /// Tempo de execução da ação em milissegundos
  duration  Int?

  // Timestamp
  /// Data/hora em que a ação foi realizada (UTC)
  createdAt DateTime @default(now())

  // Índices para performance nas consultas
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([createdAt, action])
  @@index([createdAt, userId])
}
