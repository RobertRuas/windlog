// ============================================================================
// PRISMA SCHEMA - Definição do Banco de Dados
// ============================================================================
//
// O QUE É ESTE ARQUIVO?
// ---------------------
// Este é o arquivo central do Prisma ORM. Ele define TODA a estrutura do
// banco de dados: tabelas (models), relacionamentos, enums e configurações.
//
// POR QUE PRISMA?
// ---------------
// Prisma oferece type-safety (segurança de tipos) gerando automaticamente
// tipos TypeScript baseados no schema. Isso significa que o banco de dados
// e o código estão sempre sincronizados.
//
// COMO FUNCIONA?
// --------------
// 1. Defina os models aqui
// 2. Rode: npx prisma migrate dev --name nome_da_migration
// 3. O Prisma cria as tabelas no PostgreSQL automaticamente
// 4. O código TypeScript ganha acesso aos tipos gerados
//
// CONVENÇÕES IMPORTANTES:
// -----------------------
// - IDs sempre em UUID (universally unique identifiers)
// - Datas sempre em UTC (horário universal)
// - Soft Delete: nunca apagamos dados, usamos o campo 'deletedAt'
// - Todo registro pertence a uma empresa (multi-tenant)
// - Nomes de models em PascalCase (ex: User, Project)
// - Nomes de campos em camelCase (ex: createdAt, firstName)
//
// NOTA PRISMA v7:
// ---------------
// A URL do banco NÃO fica mais aqui. Ela está em 'prisma.config.ts'.
// O client é gerado em './generated/prisma' (não mais em node_modules).
// ============================================================================

// ---------------------------------------------------------------------------
// CONFIGURAÇÃO DO GENERADOR
// ---------------------------------------------------------------------------
// 'prisma-client' é o novo provider (substitui 'prisma-client-js')
// 'output' define onde o client TypeScript será gerado
// IMPORTANTE: Após 'prisma generate', importe de './generated/prisma/client'
// ---------------------------------------------------------------------------
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// ---------------------------------------------------------------------------
// DATASOURCE - Configuração do Banco de Dados
// ---------------------------------------------------------------------------
// Define qual banco de dados usar (PostgreSQL)
// A URL da conexão está em 'prisma.config.ts' (novo no Prisma v7)
// ---------------------------------------------------------------------------
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUM: ROLE (Papéis de Usuário)
// ---------------------------------------------------------------------------
// Define os níveis de acesso do sistema (RBAC - Role-Based Access Control)
// Cada role tem permissões diferentes:
//
// - ADMIN:      Acesso completo ao sistema (gestão total)
// - HR:         Recursos Humanos (gestão de funcionários, certificados)
// - STANDARD:   Acesso padrão (operações básicas do dia-a-dia)
// ---------------------------------------------------------------------------
enum Role {
  ADMIN
  HR
  STANDARD
}

// ---------------------------------------------------------------------------
// ENUM: LANGUAGE LEVEL (Nível de Proficiência em Idiomas)
// ---------------------------------------------------------------------------
// Escala CEFR (Common European Framework of Reference for Languages)
// Usada para padronizar o nível de todos os idiomas dos funcionários
// ---------------------------------------------------------------------------
enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

// ---------------------------------------------------------------------------
// ENUM: DOCUMENT TYPE (Tipo de Documento Pessoal)
// ---------------------------------------------------------------------------
// Classifica os documentos pessoais dos funcionários multinacionais.
// Cada trabalhador internacional precisa de diversos documentos válidos
// para trabalhar legalmente em diferentes países.
// ---------------------------------------------------------------------------
enum DocumentType {
  PASSPORT
  ID_CARD
  TAX_ID
  SOCIAL_SECURITY
  WORK_PERMIT
  VISA
  DRIVERS_LICENSE
  POSTING_ORDER      // Destacamento (A1)
  MEDICAL_EXAM       // Exame médico
  OTHER
}

// ---------------------------------------------------------------------------
// ENUM: CERTIFICATION TYPE (Tipo de Certificação)
// ---------------------------------------------------------------------------
// Classifica o tipo de certificação/cursos dos funcionários
// ---------------------------------------------------------------------------
enum CertificationType {
  CERTIFICATION
  DIPLOMA
  COURSE
  TRAINING
  LICENSE
}

// ---------------------------------------------------------------------------
// MODEL: USER (Usuário do Sistema)
// ---------------------------------------------------------------------------
// Representa qualquer funcionário da empresa multinacional.
//
// CAMPOS OBRIGATÓRIOS (apenas no cadastro inicial):
// - email, password, firstName, lastName, role
//
// CAMPOS OPCIONAIS (preenchidos posteriormente):
// - Dados pessoais: phone, dateOfBirth, nationality, address
// - Dados profissionais: department, position, hireDate, bio
//
// RELACIONAMENTOS:
// - Um usuário pode ter múltiplos números de telefone
// - Um usuário pode ter múltiplas certificações/cursos
// - Um usuário pode falar múltiplos idiomas (cada um com seu nível)
// ---------------------------------------------------------------------------
model User {
  // Identificador único (UUID v4 gerado automaticamente pelo banco)
  id        String   @id @default(uuid())

  // Dados de autenticação
  email     String   @unique
  password  String

  // Dados pessoais (obrigatórios)
  firstName String
  lastName  String

  // Dados pessoais (opcionais - preenchidos posteriormente)
  /// Número de telefone principal (formato internacional)
  phone           String?
  /// Código do país do telefone (ex: "+351", "+33", "+49")
  phoneCountryCode String?
  /// Data de nascimento
  dateOfBirth     DateTime?
  /// Nacionalidade (código ISO 3166-1 alpha-2, ex: "PT", "FR", "DE")
  nationality     String?
  /// Endereço completo
  address         String?
  /// Cidade
  city            String?
  /// Código postal
  postalCode      String?
  /// País de residência (código ISO 3166-1 alpha-2)
  country         String?

  // Dados profissionais
  /// Departamento (ex: "Operations", "Maintenance", "Engineering")
  department      String?
  /// Cargo/função (ex: "Wind Turbine Technician", "Site Supervisor")
  position        String?
  /// Data de contratação na empresa
  hireDate        DateTime?
  /// Número de funcionário (ID interno da empresa)
  employeeId      String?   @unique
  /// Biografia/resumo profissional
  bio             String?

  // Documentos pessoais
  // Os documentos são geridos como relação (UserDocument) para suportar
  // múltiplos documentos de cada tipo com uploads de cópias.
  /// URL da foto do usuário (ficheiro alojado)
  photoUrl            String?

  /// Dados da assinatura do usuário (base64 PNG para uso em documentos)
  signatureData       String?

  // Controle de acesso (RBAC)
  role      Role     @default(STANDARD)
  isActive  Boolean  @default(true)
  /// Indica se o usuário precisa trocar a senha no próximo login (ex: senha temporária)
  mustChangePassword Boolean @default(false)
  /// Indica se o usuário completou o onboarding obrigatório (dados essenciais preenchidos)
  profileComplete Boolean @default(false)
  /// Indica se o usuário é Team Leader (independente do nível técnico ou role)
  isTeamLeader Boolean @default(false)

  // Dados profissionais específicos
  /// WINDA ID (ex: "RR092285BR")
  windaId           String?
  /// Nível IRATA (L1, L2, L3, NOT_APPLICABLE)
  irataLevel        String?
  /// Número IRATA (ex: "134109" ou "NOT_APPLICABLE")
  irataNumber       String?
  /// Cidade do aeroporto preferido
  preferredAirportCity    String?
  /// País do aeroporto preferido (código ISO 3166-1 alpha-2)
  preferredAirportCountry String?

  // Timestamps (datas em UTC)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  // Relações
  phoneNumbers    UserPhoneNumber[]
  certifications  UserCertification[]
  languages       UserLanguage[]
  documents       UserDocument[]
  bankAccounts    UserBankAccount[]
  projectMembers  ProjectMember[]
  projectFiles    ProjectFile[]
  notifications   Notification[]
  weeklyTimesheets WeeklyTimesheet[]
  timesheetEntries WeeklyTimesheetEntry[]
  feedbacks        Feedback[]
  ppes             UserPpe[]
}
// ---------------------------------------------------------------------------
// MODEL: USER DOCUMENT (Documentos Pessoais do Usuário)
// ---------------------------------------------------------------------------
// Registra todos os documentos pessoais do usuário.
// Contexto multinacional: funcionários trabalham em vários países e
// precisam manter documentos válidos com cópias digitalizadas.
//
// EXEMPLOS:
// - Passaporte português com validade até 2030
// - Cartão de identidade espanhol
// - NIF (Número de Identificação Fiscal) de Portugal
// - Visto de trabalho para a Alemanha
// - Permissão de residência na França
// ---------------------------------------------------------------------------
model UserDocument {
  id        String   @id @default(uuid())

  // Dados do documento
  /// Tipo de documento (enum DocumentType)
  type        DocumentType
  /// Número do documento (ex: "AB123456", "123456789")
  documentNumber String?
  /// País emissor (código ISO 3166-1 alpha-2, ex: "PT", "FR", "DE")
  issuingCountry String?
  /// Data de expedição do documento
  issueDate   DateTime?
  /// Data de validade/expiração do documento
  expiryDate  DateTime?
  /// Descrição ou notas adicionais (ex: "Visto tipo D", "Permissão de residência")
  description String?

  // Ficheiro anexado ao documento (caminho relativo ao diretório uploads/)
  /// Caminho do ficheiro anexado ao documento (relativo a uploads/{userId}/documents/)
  filePath  String?

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// MODEL: USER BANK ACCOUNT (Contas Bancárias do Usuário)
// ---------------------------------------------------------------------------
// Regista as contas bancárias do usuário para processamento de pagamentos.
// Um usuário pode ter múltiplas contas bancárias.
// ---------------------------------------------------------------------------
model UserBankAccount {
  id              String   @id @default(uuid())

  /// Nome do banco (ex: "Millennium BCP", "Caixa Geral de Depósitos")
  bankName        String
  /// IBAN (International Bank Account Number)
  iban            String
  /// Código BIC/SWIFT
  bicSwift        String?
  /// Nome completo do titular da conta
  accountHolder   String
  /// Se é a conta principal do usuário
  isPrimary       Boolean  @default(false)
  /// Descrição opcional (ex: "Conta salário", "Conta pessoal")
  description     String?

  // Relação com o usuário
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: USER PHONE NUMBER (Números de Telefone do Usuário)
// ---------------------------------------------------------------------------
// Permite que o usuário tenha múltiplos números de telefone
// de diferentes países (contexto multinacional).
//
// EXEMPLO:
// - Telefone pessoal de Portugal (+351)
// - Telefone de trabalho da França (+33)
// ---------------------------------------------------------------------------
model UserPhoneNumber {
  id        String   @id @default(uuid())

  /// Código do país (ex: "+351", "+33", "+49", "+34")
  countryCode String
  /// Número de telefone (sem código do país)
  number      String
  /// Tipo do número (móvel, fixo, trabalho, etc.)
  type        String   @default("mobile")
  /// Se é o número principal do usuário
  isPrimary   Boolean  @default(false)

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: USER CERTIFICATION (Certificações, Diplomas e Cursos)
// ---------------------------------------------------------------------------
// Registra todas as certificações profissionais do usuário.
// Usado para:
// - Certificações de manutenção de turbinas eólicas
// - Diplomas de formação técnica
// - Cursos de segurança (GWO, etc.)
// - Licenças profissionais
//
// CAMPOS IMPORTANTES:
// - issueDate:   Data em que a certificação foi obtida
// - expiryDate:  Data de validade (usado para alertas de renovação)
// - isExpired:   Calculado automaticamente com base na expiryDate
// ---------------------------------------------------------------------------
model UserCertification {
  id        String   @id @default(uuid())

  // Dados da certificação
  /// Nome/título da certificação (ex: "GWO BST", "IEC 61400", "Electrical Safety")
  name        String
  /// Entidade emissora (ex: "GWO", "Vestas", "Siemens Gamesa", "Ministry of Education")
  issuer      String
  /// Tipo de certificação (enum CertificationType)
  type        CertificationType
  /// Descrição detalhada (opcional)
  description String?
  /// Número/ID da certificação (ex: "GWO-2024-12345")
  certNumber  String?

  // Datas importantes
  /// Data de expedição (quando obteve a certificação)
  issueDate   DateTime
  /// Data de expiração (null = não expira)
  expiryDate  DateTime?

  // Arquivo/comprovativo (caminho para upload futuro)
  filePath    String?

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// MODEL: USER LANGUAGE (Idiomas Falados pelo Usuário)
// ---------------------------------------------------------------------------
// Registra cada idioma que o usuário fala com seu respectivo nível.
// Contexto multinacional: funcionários trabalham em vários países
// da União Europeia e precisam comunicar-se em diferentes idiomas.
//
// EXEMPLO:
// - Português (NATIVE)
// - Inglês (C1)
// - Francês (B2)
// - Espanhol (A2)
// ---------------------------------------------------------------------------
model UserLanguage {
  id        String   @id @default(uuid())

  /// Nome do idioma (ex: "English", "French", "German", "Spanish")
  language  String
  /// Nível de proficiência (escala CEFR: A1, A2, B1, B2, C1, C2, NATIVE)
  level     LanguageLevel

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, language])
}

// ---------------------------------------------------------------------------
// ENUM: PROJECT STATUS (Status do Projeto)
// ---------------------------------------------------------------------------
// Define os possíveis status de um projeto no sistema
// ---------------------------------------------------------------------------
enum ProjectStatus {
  PLANNING      // Planeamento
  IN_PROGRESS   // Em progresso
  ON_HOLD       // Em espera
  COMPLETED     // Concluído
  CANCELLED     // Cancelado
}

// ---------------------------------------------------------------------------
// ENUM: TURBINE STATUS (Status da Turbina)
// ---------------------------------------------------------------------------
// Define os possíveis status de uma turbina
// ---------------------------------------------------------------------------
enum TurbineStatus {
  OPERATIONAL   // Operacional
  MAINTENANCE   // Em manutenção
  OFFLINE       // Offline
  DECOMMISSIONED // Descomissionada
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT (Projeto)
// ---------------------------------------------------------------------------
// Representa um projeto de manutenção/instalação de turbinas eólicas.
// Um projeto agrupa turbinas e técnicos para um trabalho específico.
//
// CAMPOS OBRIGATÓRIOS (criação mínima):
// - name, client, location
//
// CAMPOS OPCIONAIS (preenchidos posteriormente):
// - scope, description, coordinates, startDate, status
// ---------------------------------------------------------------------------
model Project {
  id        String   @id @default(uuid())

  // Informações básicas (obrigatórias)
  /// Nome do projeto (ex: "Parque Eólico Serra do Mar")
  name        String
  /// Cliente/proprietário do projeto (ex: "EDP Renewables")
  client      String
  /// Localização geral do projeto (ex: "Serra do Mar, Portugal")
  location    String

  // Informações complementares (opcionais)
  /// Escopo do projeto (ex: "Manutenção preventiva", "Instalação")
  scope       String?
  /// Descrição detalhada do projeto
  description String?
  /// Latitude do centro do projeto (coordenadas geográficas)
  latitude    Float?
  /// Longitude do centro do projeto (coordenadas geográficas)
  longitude   Float?
  /// Data de início do projeto
  startDate   DateTime?
  /// Status atual do projeto (enum ProjectStatus)
  status      ProjectStatus @default(PLANNING)

  // Controle de acesso
  isActive    Boolean  @default(true)

  // Timestamps (datas em UTC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relações
  turbines    ProjectTurbine[]
  members     ProjectMember[]
  files       ProjectFile[]
  weeklyTimesheets WeeklyTimesheet[]
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT TURBINE (Turbina do Projeto)
// ---------------------------------------------------------------------------
// Representa uma turbina associada a um projeto.
// Cada turbina tem informações básicas de localização e modelo.
// ---------------------------------------------------------------------------
model ProjectTurbine {
  id        String   @id @default(uuid())

  // Dados da turbina
  /// Nome/identificação da turbina (ex: "T-001", "Vestas V100 #3")
  name        String
  /// Localização específica da turbina
  location    String?
  /// Fabricante (ex: "Vestas", "Siemens Gamesa", "GE Renewable Energy")
  manufacturer String?
  /// Modelo da turbina (ex: "V100-1.8 MW", "SG 4.5-145")
  model       String?
  /// Altura do nacelle (em metros)
  nacelleHeight Float?
  /// Latitude da turbina (coordenadas geográficas)
  latitude    Float?
  /// Longitude da turbina (coordenadas geográficas)
  longitude   Float?
  /// Status atual da turbina (enum TurbineStatus)
  status      TurbineStatus @default(OPERATIONAL)

  // Relação com o projeto
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT MEMBER (Membro do Projeto)
// ---------------------------------------------------------------------------
// Associa usuários (técnicos) a projetos.
// Permite saber quais técnicos estão atribuídos a cada projeto.
// ---------------------------------------------------------------------------
model ProjectMember {
  id        String   @id @default(uuid())

  // Relação com o projeto
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relação com o usuário
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Função do membro no projeto (ex: "Lead Technician", "Technician")
  role      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// MODEL: PROJECT FILE (Ficheiros do Projeto)
// ---------------------------------------------------------------------------
// Registra os ficheiros anexados a um projeto (relatórios, fotos, etc.).
// O caminho real do ficheiro está em uploads/{userId}/projects/{filename}.
// ---------------------------------------------------------------------------
model ProjectFile {
  id        String   @id @default(uuid())

  /// Nome original do ficheiro (ex: "relatorio_janeiro.pdf")
  originalName String
  /// Caminho relativo ao diretório uploads/ (ex: "userId/projects/uuid.pdf")
  filePath     String
  /// Tipo MIME do ficheiro (ex: "application/pdf", "image/jpeg")
  mimeType     String
  /// Tamanho do ficheiro em bytes
  size         Int
  /// Categoria/descrição opcional (ex: "Relatório", "Foto", "Certificado")
  category     String?

  // Relações
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// ID do usuário que fez o upload
  uploadedBy   String
  user         User    @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([projectId])
  @@index([uploadedBy])
}

// ---------------------------------------------------------------------------
// ENUM: LOG ACTION (Ações Registradas no Log)
// ---------------------------------------------------------------------------
// Define todas as ações que podem ser registradas no log do sistema.
// Usado para auditoria e rastreamento de atividades.
// ---------------------------------------------------------------------------
enum LogAction {
  // Autenticação
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  
  // Gestão de Usuários
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_DEACTIVATE
  USER_REACTIVATE
  USER_ROLE_CHANGE
  
  // Perfil
  PROFILE_UPDATE
  PROFILE_VIEW
  SIGNATURE_UPDATE
  SIGNATURE_DELETE
  
  // Telefones
  PHONE_ADD
  PHONE_UPDATE
  PHONE_DELETE
  
  // Certificações
  CERTIFICATION_ADD
  CERTIFICATION_UPDATE
  CERTIFICATION_DELETE
  
  // Idiomas
  LANGUAGE_ADD
  LANGUAGE_UPDATE
  LANGUAGE_DELETE
  
  // Documentos
  DOCUMENT_ADD
  DOCUMENT_UPDATE
  DOCUMENT_DELETE
  
  // Projetos
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  
  // Turbinas
  TURBINE_CREATE
  TURBINE_UPDATE
  TURBINE_DELETE
  
  // Técnicos
  TECHNICIAN_CREATE
  TECHNICIAN_UPDATE
  TECHNICIAN_DELETE
  
  // Ficheiros de Projeto
  PROJECT_FILE_CREATE
  PROJECT_FILE_DELETE
  
  // Notificações
  NOTIFICATION_READ
  NOTIFICATION_DELETE
  
  // Weekly Timesheets
  TIMESHEET_CREATE
  TIMESHEET_UPDATE
  TIMESHEET_DELETE
  TIMESHEET_SUBMIT
  TIMESHEET_APPROVE
  
  // Feedback
  FEEDBACK_CREATE
  FEEDBACK_UPDATE
  FEEDBACK_DELETE
  FEEDBACK_STATUS_CHANGE
  
  // Sistema
  SYSTEM_ERROR
  API_ERROR
  ACCESS_DENIED
  DATA_EXPORT
  DATA_IMPORT
  
  // Outros
  OTHER
}

// ---------------------------------------------------------------------------
// ENUM: LOG SEVERITY (Nível de Severidade do Log)
// ---------------------------------------------------------------------------
// Classifica a severidade/importância do log registrado.
// ---------------------------------------------------------------------------
enum LogSeverity {
  INFO      // Informação geral (ações normais)
  WARNING   // Aviso (algo incomum mas não crítico)
  ERROR     // Erro (algo falhou)
  CRITICAL  // Crítico (falha grave do sistema)
}

// ---------------------------------------------------------------------------
// MODEL: SYSTEM LOG (Log do Sistema)
// ---------------------------------------------------------------------------
// Registra TODAS as ações realizadas no sistema para auditoria e segurança.
// Cada log captura detalhes completos da ação realizada.
//
// CAMPOS IMPORTANTES:
// - action:      O que foi feito (enum LogAction)
// - severity:    Nível de importância (INFO, WARNING, ERROR, CRITICAL)
// - userId:      Quem fez a ação (null se foi ação do sistema)
// - entity:      Qual entidade foi afetada (User, Project, etc.)
// - entityId:    ID da entidade afetada
// - details:     Detalhes adicionais em JSON (dados antigos, novos, etc.)
// - ipAddress:   IP de onde a ação foi realizada
// - userAgent:   Browser/client usado
// - url:         URL/endpoint acessado
// - method:      Método HTTP (GET, POST, PUT, DELETE)
// - statusCode:  Código HTTP da resposta
// - duration:    Tempo de execução da ação em ms
// ---------------------------------------------------------------------------
model SystemLog {
  id        String   @id @default(uuid())

  // Ação realizada
  /// O que foi feito (enum LogAction)
  action    LogAction
  /// Nível de severidade/importância
  severity  LogSeverity @default(INFO)
  /// Descrição legível da ação (ex: "Usuário atualizou perfil")
  message   String

  // Quem fez a ação
  /// ID do usuário que realizou a ação (null se foi ação do sistema)
  userId    String?
  /// Nome do usuário (denormalizado para performance na consulta)
  userName  String?
  /// Email do usuário (denormalizado para performance na consulta)
  userEmail String?

  // O que foi afetado
  /// Tipo da entidade afetada (ex: "User", "Project", "Certification")
  entity    String?
  /// ID da entidade afetada
  entityId  String?
  /// Nome/título da entidade (denormalizado para exibição)
  entityName String?

  // Detalhes adicionais
  /// Dados adicionais em formato JSON (dados antigos, novos valores, etc.)
  details   Json?
  /// Metadata adicional (headers, query params, etc.)
  metadata  Json?

  // Contexto da requisição
  /// Endereço IP de onde a ação foi realizada
  ipAddress String?
  /// User-Agent do browser/client
  userAgent String?
  /// URL/endpoint acessado
  url       String?
  /// Método HTTP (GET, POST, PUT, DELETE, PATCH)
  method    String?
  /// Código HTTP da resposta (200, 201, 400, 401, 403, 404, 500, etc.)
  statusCode Int?
  /// Tempo de execução da ação em milissegundos
  duration  Int?

  // Timestamp
  /// Data/hora em que a ação foi realizada (UTC)
  createdAt DateTime @default(now())

  // Índices para performance nas consultas
  @@index([userId])
  @@index([action])
  @@index([severity])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([createdAt, action])
  @@index([createdAt, userId])
}

// ---------------------------------------------------------------------------
// MODEL: SYSTEM SETTING (Configurações do Sistema)
// ---------------------------------------------------------------------------
// Armazena configurações globais do sistema em formato chave/valor.
// Usado para toggles e preferências administrativas que devem persistir
// entre reinícios do servidor (ex: captura de logs ativa/pausada).
// ---------------------------------------------------------------------------
model SystemSetting {
  /// Chave única da configuração (ex: "log_capture_enabled")
  key       String   @id
  /// Valor da configuração (armazenado como string, convertido pela aplicação)
  value     String
  /// Data da última alteração
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ENUM: NOTIFICATION TYPE (Tipo de Notificação)
// ---------------------------------------------------------------------------
// Classifica o tipo/categoria da notificação enviada ao usuário.
// Cada tipo representa um contexto diferente do sistema.
// ---------------------------------------------------------------------------
enum NotificationType {
  // Ações obrigatórias (o usuário DEVE agir)
  ACTION_REQUIRED        // Ação obrigatória geral
  DOCUMENT_EXPIRING      // Documento a expirar em breve
  CERTIFICATION_EXPIRING // Certificação a expirar em breve
  PASSWORD_EXPIRING      // Senha a expirar
  
  // Recomendações (o usuário DEVERIA agir)
  RECOMMENDED_ACTION     // Ação recomendada
  PROFILE_INCOMPLETE     // Perfil incompleto
  
  // Informativas (apenas para conhecimento)
  INFO                   // Informação geral
  PROJECT_UPDATE         // Atualização de projeto
  SYSTEM_UPDATE          // Atualização do sistema
  SUCCESS                // Ação concluída com sucesso
  
  // Alertas
  WARNING                // Aviso
  ERROR                  // Erro
}

// ---------------------------------------------------------------------------
// ENUM: NOTIFICATION PRIORITY (Prioridade da Notificação)
// ---------------------------------------------------------------------------
// Define a urgência/prioridade da notificação.
// ---------------------------------------------------------------------------
enum NotificationPriority {
  LOW       // Baixa prioridade (informativas)
  MEDIUM    // Prioridade normal (recomendações)
  HIGH      // Alta prioridade (ações obrigatórias)
  URGENT    // Urgente (prazos curtos, problemas críticos)
}

// ---------------------------------------------------------------------------
// MODEL: NOTIFICATION (Notificações do Usuário)
// ---------------------------------------------------------------------------
// Representa uma notificação enviada a um usuário específico.
// Usado para alertar sobre ações necessárias, recomendações e informações.
//
// EXEMPLOS:
// - "Seu passaporte expira em 30 dias" (ACTION_REQUIRED, HIGH)
// - "Novo projeto atribuído: Parque Eólico Serra do Mar" (INFO, MEDIUM)
// - "Certificação GWO BST expirou" (ACTION_REQUIRED, URGENT)
// - "Perfil incompleto. Adicione seus dados bancários." (RECOMMENDED_ACTION, LOW)
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())

  // Dados da notificação
  /// Tipo de notificação (enum NotificationType)
  type      NotificationType
  /// Prioridade da notificação (enum NotificationPriority)
  priority  NotificationPriority @default(MEDIUM)
  /// Título da notificação (ex: "Documento a expirar")
  title     String
  /// Mensagem detalhada da notificação
  message   String
  
  // Estado da notificação
  /// Se a notificação já foi lida pelo usuário
  isRead    Boolean  @default(false)
  /// Data/hora em que foi marcada como lida
  readAt    DateTime?
  
  // Contexto opcional (para navegação direta)
  /// Entidade relacionada (ex: "Project", "UserDocument", "Certification")
  entity    String?
  /// ID da entidade relacionada (para criar links de navegação)
  entityId  String?
  
  // Dados adicionais
  /// Metadata adicional em JSON (dados extras, links, etc.)
  metadata  Json?

  // Relação com o usuário
  /// ID do usuário destinatário da notificação
  userId    String
  /// Referência ao usuário
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índices para performance
  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// ENUM: TIMESHEET STATUS (Status do Weekly Timesheet)
// ---------------------------------------------------------------------------
// Define os possíveis status de um Weekly Timesheet.
// - DRAFT:     Rascunho (ainda sendo editado pelo Team Leader)
// - SUBMITTED: Enviado/submetido para aprovação
// - APPROVED:  Aprovado pelo cliente ou gestor
// ---------------------------------------------------------------------------
enum TimesheetStatus {
  DRAFT       // Rascunho (sendo editado)
  SUBMITTED   // Enviado/submetido
  APPROVED    // Aprovado
}

// ---------------------------------------------------------------------------
// ENUM: FEEDBACK CATEGORY (Categoria do Feedback)
// ---------------------------------------------------------------------------
// Classifica o tipo de feedback reportado pelo usuário.
// ---------------------------------------------------------------------------
enum FeedbackCategory {
  BUG          // Erro/bug no sistema
  UI_ISSUE     // Problema visual/interface
  FEATURE      // Sugestão de nova funcionalidade
  INCONSISTENCY // Inconsistência de dados
  PERFORMANCE  // Problema de performance
  OTHER        // Outro
}

// ---------------------------------------------------------------------------
// ENUM: FEEDBACK PRIORITY (Prioridade do Feedback)
// ---------------------------------------------------------------------------
// Define a urgência/prioridade do feedback.
// ---------------------------------------------------------------------------
enum FeedbackPriority {
  LOW       // Baixa (sugestões, melhorias)
  MEDIUM    // Média (bugs não críticos)
  HIGH      // Alta (bugs que afetam funcionalidade)
  CRITICAL  // Crítica (sistema inutilizável)
}

// ---------------------------------------------------------------------------
// ENUM: FEEDBACK STATUS (Status do Feedback)
// ---------------------------------------------------------------------------
// Define o ciclo de vida do feedback reportado.
// ---------------------------------------------------------------------------
enum FeedbackStatus {
  NEW         // Novo (acabou de ser reportado)
  TRIAGED     // Triado (administrador já analisou)
  IN_PROGRESS // Em resolução
  RESOLVED    // Resolvido
  CLOSED      // Fechado (não aplicável ou duplicado)
}

// ---------------------------------------------------------------------------
// MODEL: FEEDBACK (Reporte de Feedback do Sistema)
// ---------------------------------------------------------------------------
// Representa um feedback/report enviado por qualquer usuário do sistema.
// Usado para reportar bugs, inconsistências, sugestões de melhorias, etc.
//
// FLUXO:
// ------
// 1. Qualquer usuário reporta um feedback (com descrição + screenshot opcional)
// 2. O feedback entra com status NEW
// 3. Apenas ADMIN vê e gerencia todos os feedbacks
// 4. ADMIN pode mudar status, prioridade e adicionar notas internas
// ---------------------------------------------------------------------------
model Feedback {
  id        String   @id @default(uuid())

  // Dados do feedback
  /// Título/resumo do feedback (ex: "Botão de salvar não funciona")
  title     String
  /// Descrição detalhada do problema/sugestão
  description String
  /// Categoria do feedback (enum FeedbackCategory)
  category  FeedbackCategory @default(OTHER)
  /// Prioridade do feedback (enum FeedbackPriority)
  priority  FeedbackPriority @default(MEDIUM)
  /// Status atual do feedback (enum FeedbackStatus)
  status    FeedbackStatus @default(NEW)

  // Contexto técnico (capturado automaticamente no momento do report)
  /// URL da página onde o feedback foi criado
  pageUrl   String?
  /// User-Agent do browser (para identificar browser/OS)
  userAgent String?
  /// Resolução do ecrã (ex: "1920x1080")
  screenResolution String?
  /// Contexto técnico completo em JSON (browser, OS, conexão, performance, etc.)
  technicalContext Json?
  /// Logs do console capturados (erros, warnings) em formato JSON
  consoleLogs Json?
  /// Logs recentes do sistema (erros do usuário) em formato JSON
  recentSystemLogs Json?

  // Screenshot
  /// Caminho relativo do screenshot (relativo a uploads/{userId}/feedbacks/)
  screenshotPath String?

  // Notas internas do administrador (para resolução)
  /// Notas/resolução adicionadas pelo ADMIN
  adminNotes String?

  // Quem reportou o feedback
  /// ID do usuário que reportou
  reportedBy String
  /// Referência ao usuário que reportou
  reporter   User     @relation(fields: [reportedBy], references: [id])

  // Quem resolveu (ADMIN que mudou status para RESOLVED/CLOSED)
  /// ID do administrador que resolveu/fechou
  resolvedBy String?
  /// Data/hora da resolução
  resolvedAt DateTime?

  // Timestamps (datas em UTC)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Soft delete (data de exclusão, null = ativo)
  deletedAt  DateTime?

  // Índices para performance nas consultas
  @@index([reportedBy])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// MODEL: WEEKLY TIMESHEET (Planilha Semanal de Horas)
// ---------------------------------------------------------------------------
// Representa uma planilha semanal de horas de trabalho (Weekly Timesheet).
// Este documento é preenchido pelo Team Leader ao final de cada semana
// e contém as horas trabalhadas, standby e travel de cada técnico por dia.
//
// VINCULAÇÃO COM PROJETO:
// -----------------------
// Cada timesheet está vinculado a um projeto existente. Os campos
// jobScope, client e siteName são preenchidos automaticamente a partir
// dos dados do projeto selecionado.
//
// ASSINATURAS:
// ------------
// O rodapé do documento contém assinatura do Team Leader e do Cliente,
// cada um com nome e data.
//
// DIAS E ENTRADAS:
// ----------------
// Os dias da semana estão em WeeklyTimesheetDay (1:N)
// As linhas de cada dia estão em WeeklyTimesheetEntry (1:N por dia)
// ---------------------------------------------------------------------------
model WeeklyTimesheet {
  // Identificador único (UUID v4)
  id        String   @id @default(uuid())

  // Relação com o projeto
  /// ID do projeto vinculado
  projectId String
  /// Referência ao projeto (de onde vem client, siteName, jobScope)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Metadata do documento (cabeçalho)
  /// Nordic Access Job Number (número interno do job)
  jobNumber  String?
  /// Número da semana ISO (ex: "26" para a 26ª semana do ano)
  week       String
  /// Número da equipe (ex: "2")
  teamNo     String?
  /// Escopo do trabalho (preenchido automaticamente do Project.scope)
  jobScope   String?
  /// Nome do cliente (preenchido automaticamente do Project.client)
  client     String?
  /// Nome do local/projeto (preenchido automaticamente do Project.name)
  siteName   String?

  // Quem criou o timesheet (Team Leader)
  /// ID do usuário que criou (Team Leader)
  createdBy  String
  /// Referência ao usuário criador
  creator    User     @relation(fields: [createdBy], references: [id])

  // Assinaturas (rodapé do documento)
  /// Nome do técnico/team leader para assinatura
  technicianName      String?
  /// Espaço para assinatura do técnico (imagem ou texto)
  technicianSignature String?
  /// Data da assinatura do técnico
  technicianDate      DateTime?
  /// Nome do cliente para assinatura
  clientName          String?
  /// Espaço para assinatura do cliente (imagem ou texto)
  clientSignature     String?
  /// Data da assinatura do cliente
  clientDate          DateTime?

  // Status do timesheet
  /// Status atual (enum TimesheetStatus: DRAFT, SUBMITTED, APPROVED)
  status     TimesheetStatus @default(DRAFT)

  // Timestamps (datas em UTC)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Soft delete (data de exclusão, null = ativo)
  deletedAt  DateTime?

  // Relações
  /// Dias da semana (7 dias, cada um com suas entradas)
  days       WeeklyTimesheetDay[]

  // Índices para performance nas consultas
  @@index([projectId])
  @@index([createdBy])
  @@index([week])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MODEL: WEEKLY TIMESHEET DAY (Dia da Semana no Timesheet)
// ---------------------------------------------------------------------------
// Representa um dia específico dentro de um Weekly Timesheet.
// Cada dia contém múltiplas entradas (uma por técnico que trabalhou naquele dia).
//
// EXEMPLO:
// --------
// Monday (2026-06-22) → 4 técnicos trabalharam → 4 WeeklyTimesheetEntry
// ---------------------------------------------------------------------------
model WeeklyTimesheetDay {
  // Identificador único (UUID v4)
  id          String   @id @default(uuid())

  // Relação com o timesheet
  /// ID do timesheet ao qual este dia pertence
  timesheetId String
  /// Referência ao timesheet pai
  timesheet   WeeklyTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  // Dados do dia
  /// Data completa do dia (ex: 2026-06-22)
  date        DateTime
  /// Nome do dia em inglês (ex: "Monday", "Tuesday")
  dayName     String
  /// Descrição do progresso diário (ex: "07:00 Tooling prepare...")
  progress    String?
  /// Ordem de exibição (0=Monday, 1=Tuesday, ..., 6=Sunday)
  sortOrder   Int      @default(0)
  /// Valores comuns a todos os técnicos do dia (turbina, horas, etc.)
  /// Armazena: localTurbineNo, turbineIdNo, towerNo, bladeNo, standbyHrs,
  /// workingHrs, travelHrs, downtimeHrs, standbyReason
  sharedValues Json?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  /// Entradas deste dia (uma por técnico/linha)
  entries     WeeklyTimesheetEntry[]

  // Índices e unicidade
  @@index([timesheetId])
  @@unique([timesheetId, date])
}

// ---------------------------------------------------------------------------
// MODEL: WEEKLY TIMESHEET ENTRY (Linha de Entrada por Dia)
// ---------------------------------------------------------------------------
// Representa uma linha de entrada de técnico dentro de um dia do timesheet.
// Cada linha contém: nome do técnico, função, turbina, horas e motivo de standby.
//
// VINCULAÇÃO COM USUÁRIO:
// -----------------------
// O campo userId é opcional. Se preenchido, o nome do técnico é puxado
// automaticamente do cadastro de usuários. Se nulo, o nome é livre.
// ---------------------------------------------------------------------------
model WeeklyTimesheetEntry {
  // Identificador único (UUID v4)
  id             String   @id @default(uuid())

  // Relação com o dia
  /// ID do dia ao qual esta entrada pertence
  dayId          String
  /// Referência ao dia pai
  day            WeeklyTimesheetDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  // Relação com o usuário (opcional)
  /// ID do usuário/técnico (nulo se for externo ao sistema)
  userId         String?
  /// Referência ao usuário (para preencher technicianName automaticamente)
  user           User?    @relation(fields: [userId], references: [id])

  // Dados do técnico e turbina
  /// Nome do técnico (preenchido do User ou manualmente)
  technicianName String
  /// Função/cargo do técnico no dia (ex: "Lead Technician", "Technician")
  role           String?
  /// Número local da turbina (ex: "WEA1")
  localTurbineNo String?
  /// ID da turbina (ex: "552201011")
  turbineIdNo    String?
  /// Número da torre Max Bögl (ex: "G20_001234_DE")
  towerNo        String?
  /// Número da pá (se aplicável)
  bladeNo        String?

  // Horas trabalhadas
  /// Horas de standby (espera)
  standbyHrs     String?
  /// Horas de trabalho efetivo
  workingHrs     String?
  /// Horas de viagem/deslocamento
  travelHrs      String?
  /// Horas de downtime da turbina (WTG)
  downtimeHrs    String?

  // Motivo de standby
  /// Razão do tempo de standby (ex: "Weather", "Parts waiting")
  standbyReason  String?

  // Ordem de exibição dentro do dia
  /// Ordem da linha dentro do dia (0 = primeira linha)
  sortOrder      Int      @default(0)

  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Índices para performance
  @@index([dayId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// ENUM: PPE CATEGORY (Categoria do EPI)
// ---------------------------------------------------------------------------
// Classifica a origem do Equipamento de Proteção Individual.
// - COMPANY_PROVIDED: fornecido pela empresa (obrigatório para trabalho)
// - PERSONAL: equipamento pessoal do trabalhador
// ---------------------------------------------------------------------------
enum PpeCategory {
  COMPANY_PROVIDED  // Fornecido pela empresa
  PERSONAL          // Pessoal do trabalhador
}

// ---------------------------------------------------------------------------
// ENUM: PPE TYPE (Tipo de EPI)
// ---------------------------------------------------------------------------
// Classifica o tipo de equipamento de proteção individual usado em
// trabalhos de energia eólica e acesso por cordas.
// ---------------------------------------------------------------------------
enum PpeType {
  HARNESS           // Arnês de segurança
  HELMET            // Capacete
  ROPE              // Corda (trabalho em altura / acesso por cordas)
  FALL_ARREST       // Dispositivo anticaída
  GLOVES            // Luvas de proteção
  FOOTWEAR          // Calçado de segurança
  EYE_PROTECTION    // Proteção ocular
  RESPIRATORY       // Proteção respiratória
  ANCHOR_CONNECTOR  // Anchor e conectores (mosquetões, talabartes)
  FIRST_AID         // Kit de primeiros socorros
  OTHER             // Outro EPI
}

// ---------------------------------------------------------------------------
// ENUM: PPE CONDITION (Condição do EPI)
// ---------------------------------------------------------------------------
// Indica o estado de conservação/validade do equipamento.
// ---------------------------------------------------------------------------
enum PpeCondition {
  NEW                // Novo (sem uso)
  GOOD               // Bom estado (apto para uso)
  FAIR               // Estado razoável (monitorar)
  NEEDS_REPLACEMENT  // Precisa ser substituído
  EXPIRED            // Expirado (validade vencida)
  RETIRED            // Aposentado (fora de circulação)
}

// ---------------------------------------------------------------------------
// MODEL: USER PPE (EPIs do Usuário)
// ---------------------------------------------------------------------------
// Registra todos os Equipamentos de Proteção Individual (EPIs) associados
// ao usuário. Inclui equipamentos fornecidos pela empresa e EPIs pessoais.
//
// CONTEXT:
// --------
// Trabalhadores de energia eólica na Europa utilizam diversos EPIs
// certificados (normas EN) que requerem inspeções periódicas.
// Cada equipamento tem número de série, marca, datas de inspeção
// e condição para garantir conformidade com as normas de segurança.
//
// EXEMPLOS:
// ---------
// - Arnês Petzl AVAO BOD com serial PZ-2024-001, inspeção anual
// - Capacete Petzl VERTEX com serial VTX-5523, validade 5 anos
// - Corda Beal ANTIPODES 10.5mm com serial BPL-88712
// ---------------------------------------------------------------------------
model UserPpe {
  id        String   @id @default(uuid())

  // Identificação do equipamento
  /// Nome/descrição do EPI (ex: "Arnês de segurança", "Capacete de proteção")
  name        String
  /// Categoria do EPI (enum PpeCategory: COMPANY_PROVIDED ou PERSONAL)
  category    PpeCategory @default(COMPANY_PROVIDED)
  /// Tipo do EPI (enum PpeType: HARNESS, HELMET, ROPE, etc.)
  type        PpeType
  /// Marca do fabricante (ex: "Petzl", "Beal", "Camp", "Kong", "Singing Rock")
  brand       String?
  /// Modelo do equipamento (ex: "AVAO BOD", "VERTEX BEST", "ANTIPODES 10.5")
  model       String?
  /// Número de série / ID único do equipamento (ex: "PZ-2024-001")
  serialNumber String?

  // Datas de aquisição e inspeção
  /// Data de aquisição/compra do equipamento
  purchaseDate DateTime?
  /// Data da última inspeção realizada
  lastInspectionDate DateTime?
  /// Data da próxima inspeção obrigatória (usada para alertas de vencimento)
  nextInspectionDate DateTime?

  // Estado do equipamento
  /// Condição atual do EPI (enum PpeCondition: NEW, GOOD, FAIR, etc.)
  condition   PpeCondition @default(GOOD)
  /// Observações/notas sobre o equipamento (ex: "Inspeção feita em Jan/2025")
  notes       String?

  // Anexo (certificado de inspeção, foto do equipamento, etc.)
  /// Caminho do ficheiro anexado (relativo a uploads/{userId}/ppes/)
  filePath    String?

  // Relação com o usuário
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Índices para performance
  @@index([userId])
  @@index([nextInspectionDate])
  @@index([condition])
}
