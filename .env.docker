# ============================================================================
# VARIÁVEIS DE AMBIENTE - Template para Docker
# ============================================================================
# COPIE este arquivo para .env e ajuste os valores antes de usar:
#   cp .env.docker .env
#
# Para usar com docker compose, edite as variáveis diretamente no
# docker-compose.yml ou use um ficheiro .env na raiz.
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# ----------------------------------------------------------------------------
# Para Docker, use o nome do serviço "db" como hostname:
DATABASE_URL="postgresql://windlog:windlog_pass@db:5432/windlog"

# Para acesso local fora do Docker (macOS/Linux):
# DATABASE_URL="postgresql://windlog:windlog_pass@localhost:5432/windlog"

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Host de escuta da API (127.0.0.1 porque nginx faz o proxy)
LISTEN_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# JWT (Autenticação)
# ----------------------------------------------------------------------------
# IMPORTANTE: Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Em Docker, o nginx serve frontend + proxy API na mesma porta (80)
CORS_ORIGIN=http://localhost

# ----------------------------------------------------------------------------
# UPLOAD DE FICHEIROS
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
FILE_TOKEN_TTL=300
