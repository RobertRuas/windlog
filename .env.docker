# ============================================================================
# VARIÁVEIS DE AMBIENTE - Produção (Servidor windlog.org)
# ============================================================================
#
# BANCO DE DADOS CENTRALIZADO:
# ----------------------------
# O PostgreSQL corre num container separado (windlog-db)
# partilhado por todas as aplicações do servidor.
# Hostname Docker: "database" (resolvido via DNS interno da rede proxy-net)
#
# Para desenvolvimento local, use API/.env.example como template.
# ============================================================================

# ----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL centralizado)
# ----------------------------------------------------------------------------
# Container windlog-db na rede proxy-net (hostname: "database")
DATABASE_URL="postgresql://windlog:windlog_pass@database:5432/windlog"

# ----------------------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Host de escuta da API (127.0.0.1 porque nginx faz o proxy interno)
LISTEN_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# JWT (Autenticação)
# ----------------------------------------------------------------------------
# IMPORTANTE: Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Domínio de produção (Cloudflare Tunnel trata do HTTPS)
CORS_ORIGIN=https://app.windlog.org

# ----------------------------------------------------------------------------
# UPLOAD DE FICHEIROS
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
FILE_TOKEN_TTL=300
